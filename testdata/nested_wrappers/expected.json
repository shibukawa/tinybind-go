{
  "routes": [
    {
      "method": "POST",
      "path": "/upload",
      "handler": {
        "form": "named",
        "name": "uploadHandler"
      },
      "request": "UploadRequest",
      "response": "UploadResponse",
      "success_statuses": [
        200
      ],
      "wrappers": {
        "max_request_body_bytes": 10485760,
        "timeout": "30s"
      }
    }
  ]
}
