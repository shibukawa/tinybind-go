{{- /*
registry emits the integrated ServeMux into the route root package. Every
import it makes points down the tree, which is what lets composition live here
without the cycle a per-route composer would create.
*/ -}}
{{ .Header }}

package {{ .Package }}

{{ template "imports" . }}
// {{ .RegisterFunc }} installs every discovered route on mux.
//
// Options are passed to the runtime on each render, so a caller supplies its
// per-request cache, timeout, and error hook here.
func {{ .RegisterFunc }}(mux {{ .Symbols.MuxType }}, options ...{{ .Symbols.RuntimeAlias }}.Option) {
{{- range .Routes }}
	mux.HandleFunc({{ .Pattern | quote }}, {{ template "handler" dict "Route" . "Top" $ }})
{{- end }}
{{- if .Actions }}

	// Server function endpoints. Each handler owns its whole response, so
	// nothing is generated around it; registration is all there is.
{{- range .Actions }}
	mux.HandleFunc({{ .Pattern | quote }}, {{ .Selector }}{{ .Name }})
{{- end }}
{{- end }}
}

{{ if .Symbols.MuxConstructor }}
// {{ .MuxFunc }} returns a router carrying every discovered route.
func {{ .MuxFunc }}(options ...{{ .Symbols.RuntimeAlias }}.Option) {{ .Symbols.MuxType }} {
	mux := {{ .Symbols.MuxConstructor }}()
	{{ .RegisterFunc }}(mux, options...)
	return mux
}
{{ end }}

// {{ .TableVar }} lists what the filesystem knows about each route, so a
// framework can build a sitemap or an inspector without a metadata format.
//
// Pattern is spelled for the router these routes are registered on, while Path
// is the address the filesystem declared. They differ only where the router
// spells a segment differently than net/http does.
var {{ .TableVar }} = []RouteInfo{
{{- range .Routes }}
	{Pattern: {{ .Pattern | quote }}, Path: {{ .Path | quote }}, Dir: {{ .RelDir | quote }}, Params: {{ if .ParamNames }}[]string{ {{- range $i, $n := .ParamNames }}{{ if $i }}, {{ end }}{{ $n | quote }}{{ end -}} }{{ else }}nil{{ end }}},
{{- end }}
}

// RouteInfo is one entry of {{ .TableVar }}.
type RouteInfo struct {
	// Pattern is what the route is registered under, spelled for the router.
	Pattern string
	// Path is the address the filesystem declared, in net/http spelling. It is
	// the one to build a sitemap from, because a router's own spelling of a
	// catch-all is not a URL.
	Path string
	// Dir is the route directory relative to the route root.
	Dir string
	// Params names the dynamic segments, in route order.
	Params []string
}

// {{ .ActionTableVar }} lists every server function endpoint. Every exported
// handler in a route package is reachable whether or not a template references
// it, so this is what makes that surface inspectable.
//
// An endpoint grants nothing: the path hides structure but is not a capability
// token, so each handler still authenticates and authorizes its own caller.
var {{ .ActionTableVar }} = []ActionInfo{
{{- range .Actions }}
	{Pattern: {{ .Pattern | quote }}, Path: {{ .Path | quote }}, Dir: {{ .RelDir | quote }}, Handler: {{ .Name | quote }}, Hash: {{ .Hash | quote }}},
{{- end }}
}

// ActionInfo is one entry of {{ .ActionTableVar }}.
type ActionInfo struct {
	// Pattern is the stdlib ServeMux pattern the endpoint is registered under.
	Pattern string
	// Path is the pattern without its method.
	Path string
	// Dir is the declaring package's directory relative to the route root.
	Dir string
	// Handler is the exported Go function name.
	Handler string
	// Hash is the stable half of the path.
	Hash string
}

{{- define "handler" }}
{{- $r := .Route }}{{- $t := .Top }}
{{- if $r.Raw }}
{{ $r.Selector }}Load
{{- else }}
func({{ $t.Symbols.HandlerParams }}) {
		route, err := {{ $r.Selector }}{{ $t.DecodeFunc }}({{ $t.Symbols.Request }})
		if err != nil {
			{{ $t.Symbols.ErrorAlias }}.{{ $t.Symbols.WriteError }}({{ $t.Symbols.TransportArgs }}, err)
			return
		}
		_ = route // a route with no dynamic segment and no query input reads nothing
{{- if $r.Call }}
		{{ $r.CallResults }}{{ $r.Selector }}Load({{ $r.CallArgs }})
		if err != nil {
			{{ $t.Symbols.ErrorAlias }}.{{ $t.Symbols.WriteError }}({{ $t.Symbols.TransportArgs }}, err)
			return
		}
{{- end }}
		params := {{ $r.Selector }}PageParams{
{{- range $r.PageFields }}
			{{ .Field }}: {{ .From }},
{{- end }}
		}
{{- if $r.Layouts }}
		wrappers := []{{ $t.Symbols.RuntimeAlias }}.Wrapper{
{{- range $r.Layouts }}
			{{ .Selector }}{{ .Binder }}({{ .Selector }}{{ .ParamsType }}{
{{- range .Args }}
				{{ .Field }}: route.{{ .From }},
{{- end }}
			}),
{{- end }}
		}
{{- end }}
		if err := {{ template "render" ($t.Render $r) }}; err != nil {
			{{ $t.Symbols.ErrorAlias }}.{{ $t.Symbols.WriteError }}({{ $t.Symbols.TransportArgs }}, err)
		}
	}
{{- end }}
{{- end }}

{{- define "imports" }}
{{- if eq (len .Imports) 1 }}
import {{ (index .Imports 0).Path | quote }}
{{ else }}
import (
{{- range .Imports }}
{{- if .Group }}
{{ end }}
	{{ if .Alias }}{{ .Alias }} {{ end }}{{ .Path | quote }}
{{- end }}
)
{{ end }}
{{- end }}
